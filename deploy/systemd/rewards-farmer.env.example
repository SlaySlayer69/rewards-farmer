# Copy to /etc/rewards-farmer.env. Read by rewards-farmer.service.
#
# The schedule itself lives in the timer, not here: systemd owns that, and
# OnCalendar plus RandomizedDelaySec do the same job as REWARDS_SCHEDULE and
# REWARDS_JITTER_MINUTES do in the Docker install. Change it with
#
#   sudo systemctl edit rewards-farmer.timer

# trends needs no account, no key and no model.
QUERY_SOURCE=trends
# QUERY_SOURCE=llm
# OLLAMA_HOST=127.0.0.1:11434

# One profile directory per account, comma separated. Empty means the single
# profile in the state directory.
REWARDS_ACCOUNTS=

# DEBUG also attaches a stack trace to every [FAIL] line. Worth turning on
# while an install is new, and off once it has been earning for a week.
REWARDS_FARMER_LOG_LEVEL=INFO
