# Copy to .env next to docker-compose.yml and edit. Compose reads it on its own.
#
#   cp .env.example .env

# When the daily run starts, local time in REWARDS_TZ.
REWARDS_SCHEDULE=09:00

# A random offset of up to this many minutes is added to that time. Fixed per
# day, so a restart does not move a run that is already scheduled. Set to 0 to
# run at exactly REWARDS_SCHEDULE, which is not recommended.
REWARDS_JITTER_MINUTES=90

# The zone the schedule is written in. A container has none of its own, so
# without this the run happens at that time in UTC.
REWARDS_TZ=Europe/Berlin

# Run a missed day as soon as the machine is back, instead of waiting for the
# next slot. Set to 0 to only ever run at the scheduled time.
REWARDS_CATCH_UP=1

# A failed run is retried this many times, this many minutes apart, and never
# past midnight.
REWARDS_RETRY_MINUTES=30
REWARDS_MAX_RETRIES=2

# A run that outlasts this is killed, browser and all. A full run takes 10-30
# minutes per account.
REWARDS_RUN_TIMEOUT_MINUTES=120

# Who owns data-dir and state on the host. Inside an unprivileged Proxmox
# container this is usually 1000; check with `id -u` and `id -g`.
REWARDS_UID=1000
REWARDS_GID=1000

# trends needs no account, no key and no model. llm needs a reachable ollama.
QUERY_SOURCE=trends
# OLLAMA_HOST=host.docker.internal:11434

# One profile directory per account, comma separated. Leave empty for the
# single profile in data-dir.
REWARDS_ACCOUNTS=

# The one-time sign-in over VNC. The default publishes port 5900 on this
# machine's loopback, reached with `ssh -N -L 5900:127.0.0.1:5900 root@here`.
# Set the bind to 0.0.0.0 only if you cannot SSH in at all - and then a password
# is required, since it is a signed-in browser anyone on the network can drive.
# REWARDS_VNC_BIND=127.0.0.1
# REWARDS_VNC_PASSWORD=
# Which account's profile to sign in, when REWARDS_ACCOUNTS is in use.
# REWARDS_SIGNIN_ACCOUNT=

# DEBUG also attaches a stack trace to every [FAIL] line.
REWARDS_FARMER_LOG_LEVEL=INFO
